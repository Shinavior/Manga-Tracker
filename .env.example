# ==============================================================================
# Manga Tracker — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. App URL & Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://your-manga-tracker.vercel.app
NEXT_PUBLIC_APP_VERSION=0.1.0-beta

# ------------------------------------------------------------------------------
# 2. Database (Supabase PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Direct or connection-pooled PostgreSQL connection string from Supabase:
# Settings -> Database -> Connection string -> URI
DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Authentication (Supabase Auth)
# ------------------------------------------------------------------------------
# Set to 'multi_user' for production with Google OAuth / Email Magic Link
# Set to 'single_user' for local offline development without sign-in
AUTH_MODE=multi_user

# Supabase API credentials (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Admin Email (authorized to access /admin/feedback)
ADMIN_EMAIL=your-email@example.com

# (Optional) Fallback single-user UUID
SINGLE_USER_ID=00000000-0000-0000-0000-000000000001
SINGLE_USER_SECRET=generate_a_random_hex_secret_here

# ------------------------------------------------------------------------------
# 4. Background Automated Jobs (Vercel Cron)
# ------------------------------------------------------------------------------
# Secret token used by Vercel Cron to trigger /api/cron/* endpoints
CRON_SECRET=generate_a_secure_random_cron_secret_here

# ------------------------------------------------------------------------------
# 5. Outbound Scraping & Resolver Tuning
# ------------------------------------------------------------------------------
SCRAPER_USER_AGENT="MangaTracker/1.0 (+https://your-manga-tracker.vercel.app)"
MAX_FETCH_BYTES=1048576
FETCH_TIMEOUT_MS=8000
MANGADEX_MAX_CONCURRENT=2
